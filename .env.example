# ============================================================================
# XPRESS NURSE - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Duplicate this file as '.env' and fill in your project credentials.
# ============================================================================

# Supabase Backend Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare R2 Storage Configuration
VITE_CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
VITE_CLOUDFLARE_R2_BUCKET_NAME=xpressnurse-storage
VITE_CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your_hash.r2.dev
VITE_CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
